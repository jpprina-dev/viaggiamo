FROM node:18-alpine

# Install dependencies for better performance
RUN apk add --no-cache libc6-compat

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy all files
COPY . .

# Expose port
EXPOSE 3000

# Run in development mode with hot-reload
CMD ["npm", "run", "dev"]
